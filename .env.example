# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cascadia

# The test suite's own database, and it will not run without this. Tests
# truncate tables and commit shared config rows, so pointing them at the
# database above rewrites what you are working on. Nothing is derived or
# guessed — create the database this URL names, then build its schema with
# `npm run test:db:push`. Full recipe:
# packages/core/src/__tests__/README.md
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cascadia_test

# Database name used by docker-compose to build the containerized workers'
# DATABASE_URL (see ${POSTGRES_DB} in docker-compose.yml). Compose does NOT
# read DATABASE_URL above — it composes its own from POSTGRES_USER/HOST/DB — so
# if you point DATABASE_URL at a differently-named database, set this to match.
# Leaving both at the default is correct for a normal setup.
# POSTGRES_DB=cascadia

# Authentication
# Sessions are opaque random tokens stored hashed in the database — no session
# signing secret exists or is needed.

# OAuth Providers (Optional)
# GitHub is the only implemented provider. Azure AD and Google are roadmap
# items, so no AZURE_* or GOOGLE_* variable is read by anything yet.
# The callback URL is derived from BASE_URL below — register
# {BASE_URL}/api/v1/auth/callback/github with your GitHub OAuth App.
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Application
BASE_URL=http://localhost:3000
NODE_ENV=development

# Vault Configuration
VAULT_ROOT=./vault
VAULT_TYPE=local

# Messaging (Optional)
# MQTT_BROKER=tcp://mqtt.factory.local:1883
# MQTT_USERNAME=plm-system
# MQTT_PASSWORD=secure-password

# Jobs Server (RabbitMQ)
# Note: On Windows with Docker Desktop, the worker must run inside Docker
# Use: docker compose --profile dev up jobs-worker-dev -d
RABBITMQ_URL=amqp://cascadia:cascadia@localhost:5672

# Jobs Worker Settings (optional, for docker-compose)
# WORKER_CONCURRENCY=5
# JOB_TYPES=*
# JOB_TIMEOUT=300000

# When running PostgreSQL on Windows host with jobs worker in Docker:
# POSTGRES_HOST=host.docker.internal

# Encryption key for sensitive data at rest (admin-entered provider API keys).
# AES-256-GCM, 64 hex chars. If unset, those keys are stored in plaintext in
# the database — set this for any deployment that holds real provider keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# CAD Generation (Zoo Text-to-CAD, used by the collaborative design engine)
# Optional: can also be configured in the UI at /admin/ai (CAD Generation
# section). A key saved and enabled in the UI overrides this variable.
# ZOO_API_KEY=
# ZOO_TEXT_TO_CAD_TIMEOUT_MS=600000
# ZOO_TEXT_TO_CAD_CONCURRENCY=3

# Database SSL/TLS
# When NODE_ENV=production the app requires TLS unless you opt out. Set to
# "disable" for private-network deployments (e.g. compose-bundled postgres),
# or "require" to force TLS regardless of NODE_ENV.
# DATABASE_SSL=
#
# Alternatively, pass sslmode in the connection string (libpq style):
#   DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=disable
# Supported sslmode values: disable, require, verify-ca, verify-full.
# DATABASE_SSL takes precedence over ?sslmode= when both are set.
#
# Path to CA certificate for database SSL verification.
# Required when sslmode is verify-ca or verify-full; optional with require.
# DATABASE_CA_CERT_PATH=

# Email/SMTP (required for notification jobs in production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=plm@example.com