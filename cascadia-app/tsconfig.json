{
  "extends": "../tsconfig.base.json",
  // The app-level configs are type-checked code too — without them here,
  // ESLint has no project for them and refuses to parse.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "drizzle.config.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../cascadia-web/src/*",
        "../cascadia-api/src/*",
        "../cascadia-commons/src/*"
      ],
      "@cascadia/api/*": ["../cascadia-api/src/*"],
      "@cascadia/web/*": ["../cascadia-web/src/*"],
      "@cascadia/commons/*": ["../cascadia-commons/src/*"]
    }
  }
}
