{
  "extends": "./tsconfig.base.json",
  // Everything outside the workspace packages: root tooling and the E2E suite.
  // The packages and apps each have their own project; this one catches what
  // would otherwise belong to none, which type-aware linting treats as an error.
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "publish/**/*.ts",
    "publish/**/*.mjs",
    "tests/**/*.ts",
    "*.config.ts",
    "eslint.config.js",
    "prettier.config.js"
  ],
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./packages/core/src/*"],
      "@cascadia/core/*": ["./packages/core/src/*"]
    }
  }
}
