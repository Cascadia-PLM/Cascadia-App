# Docker Environment Configuration
# Copy this file to .env when using Docker Compose

# Application
NODE_ENV=production
APP_PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL Database
# POSTGRES_PASSWORD has no compose default — the stack refuses to start
# without it. Generate one: openssl rand -hex 24
POSTGRES_DB=cascadia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-generate-a-real-password
POSTGRES_PORT=5432

# Database URL (automatically constructed for Docker; keep the password in
# sync with POSTGRES_PASSWORD above, and the database name with POSTGRES_DB)
DATABASE_URL=postgresql://postgres:CHANGE-ME-generate-a-real-password@postgres:5432/cascadia

# RabbitMQ (background jobs)
# These two have compose defaults (cascadia/cascadia), unlike the Postgres
# password — tolerable only because the broker binds to loopback (see the bind
# note below), so treat the default as "not exposed yet" rather than "safe".
# The app and every worker build their RABBITMQ_URL from these same variables,
# so changing them here keeps both ends of the connection in sync.
# They seed the broker on its FIRST boot only: the user lives in the
# rabbitmq_data volume afterwards, so a later change needs rabbitmqctl or a
# recreated volume.
RABBITMQ_USER=cascadia
RABBITMQ_PASSWORD=CHANGE-ME-generate-a-real-password

# File Storage
FILE_STORAGE_PATH=/app/storage/files
VAULT_ROOT=/app/vault
VAULT_TYPE=local

# Encryption key for sensitive data at rest (admin-entered provider API keys).
# AES-256-GCM, 64 hex chars. If unset, those keys are stored in plaintext in
# the database — set this for any deployment that holds real provider keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Optional: pgAdmin (only if using 'tools' profile)
# No compose default — required when the tools profile is active.
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@cascadia.local
PGADMIN_PASSWORD=CHANGE-ME-generate-a-real-password

# Infrastructure ports bind to 127.0.0.1 by default (containers talk over the
# compose network; the mappings exist for host-side tools). To expose one on
# all interfaces deliberately, override its bind address:
# POSTGRES_BIND=0.0.0.0
# RABBITMQ_BIND=0.0.0.0
# PGADMIN_BIND=0.0.0.0

# OAuth Providers (Optional)
# GitHub is the only implemented provider. Set both to enable the login-page
# button; the callback URL is derived from BASE_URL and is not configurable.
# GITHUB_CLIENT_ID=your-client-id
# GITHUB_CLIENT_SECRET=your-client-secret

# Email Configuration (Optional)
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=plm@example.com
# SMTP_PASS=password

# Messaging (Optional)
# MQTT_BROKER=tcp://mqtt.factory.local:1883
# MQTT_USERNAME=plm-system
# MQTT_PASSWORD=secure-password
