# Distributed Deployment - Jobs Server Configuration
# Copy to .env and customize

# =============================================================================
# REQUIRED - Must set before starting
# =============================================================================

# PostgreSQL on infrastructure server
DATABASE_URL=postgresql://postgres:PASSWORD@infra-server:5432/cascadia

# RabbitMQ on infrastructure server
RABBITMQ_URL=amqp://cascadia:PASSWORD@infra-server:5672/cascadia

# MinIO/S3 on infrastructure server
S3_ENDPOINT=http://infra-server:9000
S3_ACCESS_KEY=cascadia
S3_SECRET_KEY=

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================

# Number of concurrent jobs per worker container
WORKER_CONCURRENCY=5

# Job types to process (* for all, or comma-separated list)
# Examples:
#   JOB_TYPES=*                              # All job types
#   JOB_TYPES=reports,notifications,cleanup  # General tasks
#   JOB_TYPES=conversion.cad                 # CAD conversions only
#   JOB_TYPES=conversion.office              # Office conversions only
JOB_TYPES=*

# Default job timeout in milliseconds
JOB_TIMEOUT=300000

# Number of worker container replicas
WORKER_REPLICAS=2

# =============================================================================
# STORAGE
# =============================================================================

S3_BUCKET=cascadia-vault

# =============================================================================
# DOMAIN EVENT CONSUMERS
# =============================================================================

# How often this worker looks for new events, in milliseconds.
EVENT_POLL_INTERVAL_MS=2000

# Consecutive handler failures after which a consumer parks and stops retrying
# until an admin resumes it or skips the event.
EVENT_CONSUMER_PARK_AFTER=10

# Days of event history the retention job keeps. An event is deleted only when
# it is older than this AND every consumer has passed it. Zero or less retains
# forever.
EVENT_RETENTION_DAYS=90

# How often the webhook delivery pump looks for pending deliveries.
WEBHOOK_PUMP_INTERVAL_MS=5000

# Days of webhook delivery history kept by the same retention job. Zero or less
# retains forever; a pending delivery is never pruned whatever its age.
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# Required to sign webhook deliveries -- 64 hex characters, the SAME value the
# app tier uses. The pump refuses to start when a signed subscription exists and
# this is unset, rather than delivering unsigned.
# ENCRYPTION_KEY=

# Set EVENT_CONSUMERS_IN_APP=false on the APP server in this topology: the
# worker is deployed, so one poller is enough. (The variable belongs to the app
# server's environment, not this one.)

# =============================================================================
# IMAGE VERSION
# =============================================================================

JOBS_VERSION=latest
NODE_ENV=production
