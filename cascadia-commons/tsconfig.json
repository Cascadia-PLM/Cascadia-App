{
  "extends": "../../tsconfig.base.json",
  // Commons depends on nothing in the workspace, and maps no aliases at all:
  // there is no path for `@cascadia/api` or `@cascadia/web`, so an import of
  // either fails to resolve here before it can fail anywhere else — and no
  // `@/` either, because commons files are compiled inside the api's and the
  // web's programs as well as this one, where `@/` means a different root.
  // Commons imports itself relatively.
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "baseUrl": "."
  }
}
