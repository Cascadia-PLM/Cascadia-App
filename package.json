{
  "name": "cascadia",
  "version": "0.5.0",
  "description": "Code-first, type-safe Product Lifecycle Management (PLM) system with ECO-as-Branch versioning. Built with Hono + Vite + TanStack Router + PostgreSQL.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cascadia-PLM/Cascadia-App.git"
  },
  "homepage": "https://github.com/Cascadia-PLM/Cascadia-App#readme",
  "bugs": {
    "url": "https://github.com/Cascadia-PLM/Cascadia-App/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "node scripts/dev.mjs --client",
    "dev:api": "node scripts/dev.mjs --api",
    "build": "node scripts/build-app.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:setup": "tsx scripts/e2e-setup.ts",
    "test:e2e:full": "npm run db:reset:seed && npm run test:e2e",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --max-warnings 0",
    "typecheck": "npm run typecheck:strict",
    "typecheck:strict": "node scripts/typecheck-all.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --write . && node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --fix",
    "openapi:snapshot": "tsx scripts/snapshot-openapi.ts",
    "openapi:check": "tsx scripts/snapshot-openapi.ts --check",
    "types:openapi": "node scripts/generate-api-types.mjs",
    "types:openapi:check": "node scripts/generate-api-types.mjs --check",
    "license:fix": "node scripts/license-headers.mjs",
    "license:check": "node scripts/license-headers.mjs --check",
    "license:thirdparty": "node scripts/check-third-party-licenses.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs --out THIRD-PARTY-NOTICES.txt",
    "boundary:check": "node scripts/check-core-boundary.mjs",
    "test:hygiene:check": "node scripts/check-test-config-hygiene.mjs",
    "bodies:check": "node scripts/check-annotated-bodies.mjs",
    "permissions:check": "tsx scripts/check-permission-tuples.ts",
    "db:generate": "node scripts/drizzle.mjs generate",
    "db:migrate": "node scripts/drizzle.mjs migrate",
    "db:baseline": "tsx scripts/db-baseline.ts",
    "db:check-orphans": "tsx scripts/check-versioning-orphans.ts",
    "db:check-migrations": "node scripts/check-migration-schema.mjs",
    "db:check-backfills": "node scripts/check-migration-backfills.mjs",
    "db:push": "node scripts/drizzle.mjs push",
    "test:db:push": "node scripts/test-db-push.mjs",
    "db:studio": "node scripts/drizzle.mjs studio",
    "db:seed": "tsx scripts/seed-minimal.ts",
    "db:sync-roles": "tsx scripts/sync-role-permissions.ts",
    "db:seed:catalog": "tsx scripts/seed-catalog.ts",
    "db:seed:tools": "tsx scripts/seed-tools.ts",
    "db:seed:demo": "tsx scripts/seed-demo-robot-arm.ts",
    "db:drop": "tsx scripts/drop-all-tables.ts",
    "db:reset": "tsx scripts/truncate-all.ts",
    "db:reset:seed": "tsx scripts/truncate-all.ts && tsx scripts/seed-minimal.ts",
    "db:drop:seed": "tsx scripts/drop-all-tables.ts && node scripts/drizzle.mjs push --force && tsx scripts/seed-minimal.ts",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d",
    "demo:down": "docker compose -f docker-compose.demo.yml down",
    "demo:reset": "docker compose -f docker-compose.demo.yml down -v && docker compose -f docker-compose.demo.yml up -d",
    "demo:logs": "docker compose -f docker-compose.demo.yml logs -f app",
    "demo:fetch": "tsx scripts/fetch-demo-data.ts",
    "deploy:install": "tsx scripts/deploy/install.ts",
    "mcp:dev-server": "tsx packages/core/src/mcp-dev-server.ts",
    "jobs:worker": "node scripts/workers.mjs jobs:built",
    "jobs:worker:dev": "node scripts/workers.mjs jobs",
    "cad:worker:dev": "docker compose --profile cad up cad-converter-dev --build -d && docker logs -f cascadia-cad-converter-dev",
    "cad:worker:stop": "docker compose --profile cad stop cad-converter-dev",
    "cad:worker:logs": "docker logs -f cascadia-cad-converter-dev",
    "workers:dev": "node scripts/workers.mjs dev",
    "workers:stop": "node scripts/workers.mjs stop",
    "workers:logs": "node scripts/workers.mjs logs",
    "build:community": "npm run build:app -- cascadia",
    "build:app": "node scripts/build-app.mjs",
    "docs:check-claims": "node scripts/check-version-claims.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.993.0",
    "@cantoo/pdf-lib": "^2.8.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^1.19.14",
    "@hono/standard-validator": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@scalar/hono-api-reference": "^0.10.14",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/ai": "^0.2.2",
    "@tanstack/ai-anthropic": "^0.2.0",
    "@tanstack/ai-openai": "^0.2.1",
    "@tanstack/ai-react": "^0.2.2",
    "@tanstack/react-form": "^1.27.1",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-router": "^1.139.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.139.14",
    "@xyflow/react": "12.11.2",
    "amqplib": "^0.10.9",
    "arctic": "^3.7.0",
    "codemirror": "^6.0.2",
    "dagre": "^0.8.5",
    "dotenv": "^17.2.3",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.12.12",
    "hono-openapi": "^1.3.0",
    "lucide-react": "^0.544.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.0.6",
    "three": "^0.182.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.11",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.0.2",
    "@playwright/test": "^1.49.0",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/amqplib": "^0.10.8",
    "@types/dagre": "^0.7.53",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "baseline-browser-mapping": "^2.9.2",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "jsdom": "^27.0.0",
    "openapi-typescript": "7.13.0",
    "ora": "^9.0.0",
    "prettier": "3.9.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "web-vitals": "^5.1.0",
    "yaml": "^2.8.2"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
